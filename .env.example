# Database
POSTGRES_USER=tradeflow
POSTGRES_PASSWORD=tradeflow
POSTGRES_DB=tradeflow
DATABASE_URL=postgresql+asyncpg://tradeflow:tradeflow@timescaledb:5432/tradeflow

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# APIs
FINANCIAL_DATASETS_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Datadog
DATADOG_API_KEY=your-key-here

# Cache TTLs (seconds)
CACHE_TTL_CURRENT_PRICE=30
CACHE_TTL_NEWS=900
CACHE_TTL_FUNDAMENTALS=86400
CACHE_TTL_HISTORICAL=3600