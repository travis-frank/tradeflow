FROM python:3.11-slim

WORKDIR /app

ENV UV_SYSTEM_PYTHON=1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml .

ARG INSTALL_DEV=false
RUN if [ "$INSTALL_DEV" = "true" ]; then \
        uv pip install --system ".[dev]"; \
    else \
        uv pip install --system .; \
    fi

COPY . .

EXPOSE 8000